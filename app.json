{
  "expo": {
    "name": "VentaLocal",
    "slug": "ventalocal",
    "version": "1.0.0",
    "icon": "./assets/ventalocal-icon.png",
    "orientation": "portrait",
    "scheme": "ventalocal",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ventalocal-icon.png",
        "backgroundColor": "#EAF6F3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
